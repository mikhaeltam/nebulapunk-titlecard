<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="preload" as="image" href="Light%20Gate%20Wireframe%20%2B%20Clay%20Render.png">
<link rel="preload" as="image" href="Light%20Gate%2010.png">
<style>
  html,body{margin:0;padding:0;background:rgb(7,4,18);overflow:hidden;height:100%;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;}
  .cmp{position:relative;width:100%;height:100vh;overflow:hidden;cursor:ew-resize;user-select:none;-webkit-user-select:none;}
  .cmp img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;-webkit-user-drag:none;pointer-events:none;}
  .cmp .after{clip-path:inset(0 0 0 50%);}
  .label{position:absolute;bottom:24px;font-size:11px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;color:rgba(245,245,247,0.9);padding:5px 12px;border:1px solid rgba(245,245,247,0.4);border-radius:100px;background:rgba(7,4,18,0.5);}
  .label-before{left:28px;}
  .label-after{right:28px;}
  .divider{position:absolute;top:0;bottom:0;left:50%;width:2px;background:rgba(245,245,247,0.85);transform:translateX(-1px);pointer-events:none;box-shadow:0 0 12px rgba(245,245,247,0.35);}
  .handle{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:44px;height:44px;border-radius:50%;background:rgba(7,4,18,0.9);border:1.5px solid rgba(245,245,247,0.7);display:flex;align-items:center;justify-content:center;box-shadow:0 0 20px rgba(0,0,0,0.6);}
  .handle svg{width:18px;height:18px;fill:none;stroke:#f5f5f7;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
</style>
</head>
<body>
<div class="cmp" id="cmp">
  <img src="Light%20Gate%20Wireframe%20%2B%20Clay%20Render.png" alt="Light Gate wireframe">
  <img src="Light%20Gate%2010.png" alt="Light Gate final render" class="after" id="after">
  <span class="label label-before">&#9679;&nbsp;&nbsp;BEFORE</span>
  <span class="label label-after">AFTER&nbsp;&nbsp;&#9679;</span>
  <div class="divider" id="divider">
    <div class="handle">
      <svg viewBox="0 0 24 24"><polyline points="9 6 3 12 9 18"></polyline><polyline points="15 6 21 12 15 18"></polyline></svg>
    </div>
  </div>
</div>
<script>
(function(){
  var cmp=document.getElementById('cmp');
  var after=document.getElementById('after');
  var divider=document.getElementById('divider');
  var dragging=false;
  function move(x){
    var r=cmp.getBoundingClientRect();
    var pct=Math.max(0,Math.min(100,((x-r.left)/r.width)*100));
    after.style.clipPath='inset(0 0 0 '+pct+'%)';
    divider.style.left=pct+'%';
  }
  cmp.addEventListener('mousedown',function(e){dragging=true;move(e.clientX);e.preventDefault();});
  window.addEventListener('mousemove',function(e){if(dragging)move(e.clientX);});
  window.addEventListener('mouseup',function(){dragging=false;});
  cmp.addEventListener('touchstart',function(e){dragging=true;move(e.touches[0].clientX);},{passive:true});
  cmp.addEventListener('touchmove',function(e){if(dragging){move(e.touches[0].clientX);e.preventDefault();}},{passive:false});
  cmp.addEventListener('touchend',function(){dragging=false;});
})();
</script>
</body>
</html>
